# Lightweight ARM64 worker image for Apple Silicon Docker.
# This is not the full Kali pentest image. Install extra tools yourself if needed.
FROM node:22-bookworm

RUN apt-get update && \
    apt-get install -y --no-install-recommends \
      python3 python3-pip git curl jq ca-certificates coreutils && \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g \
      @anthropic-ai/claude-code@2.1.98 \
      @openai/codex@0.118.0 \
      @mariozechner/pi-coding-agent@0.73.0

RUN useradd -m -s /bin/bash cairn
COPY --chown=cairn:cairn ./.agents /home/cairn/workspace/.agents
COPY --chown=cairn:cairn ./.agents /home/cairn/workspace/.claude
COPY --chown=cairn:cairn ./AGENTS.md /home/cairn/workspace/AGENTS.md
COPY --chown=cairn:cairn ./AGENTS.md /home/cairn/workspace/CLAUDE.md
USER cairn
WORKDIR /home/cairn/workspace
RUN git init
ENV TZ=Asia/Shanghai
ENV PYTHONUNBUFFERED=1
ENV CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1
CMD ["sleep", "infinity"]
